# Django Settings
DEBUG=False
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Production requires at least 50 private random characters.
SECRET_KEY=replace-with-a-private-random-secret-of-at-least-fifty-characters
ALLOWED_HOSTS=groceries.samuelpetre.com

# Docker Compose runtime identity and network exposure.
# Match these IDs to the owner of this checkout (id -u / id -g).
APP_UID=1000
APP_GID=1000
# Cloudflare Tunnel running on this host should use http://127.0.0.1:8000.
# Set WEB_BIND_ADDRESS to a specific host interface only when your proxy needs it.
WEB_BIND_ADDRESS=127.0.0.1

# Logging
LOG_LEVEL=INFO

# Security / proxy (Cloudflare Tunnel terminates TLS, Django sees http)
CSRF_TRUSTED_ORIGINS=https://groceries.samuelpetre.com
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
# Optional HSTS tuning (defaults shown; see settings.py)
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# For local dev without a tunnel, relax the redirect:
# SECURE_SSL_REDIRECT=False

# Note: The database is set to SQLite by default in settings.py for portability.
# If you wish to use PostgreSQL, set your DATABASE_URL here and update settings.py.
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# IPCA reference series (BCB SGS codes, monthly %). Food default 1635 is
# shown next to the chart label; override if BCB renumbers it.
# IPCA_SERIES_GERAL=433
# IPCA_FOOD_SERIES=1635

# Product enrichment (tracker/enrichment.py)
# Contact string sent as our API User-Agent (required by Open Food Facts
# terms so they can reach us instead of blocking unidentified traffic).
# ENRICHMENT_CONTACT=GroceriesTracker (you@example.com)
# Optional: Mercado Livre developer token for GTIN-verified catalog lookups.
# Without it, enrichment uses the public ML search + scraping fallbacks.
# MELI_ACCESS_TOKEN=
